# FinAdvisor AI - Environment Variables Example
# Copy this file to .env and fill in your values

# ── Flask Backend ────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ── SQLite (default, always available) ───────────────────────────────────────
DATABASE_URL=sqlite:///finadvisor.db

# ── MongoDB (optional — enables MongoDB features) ────────────────────────────
# Local MongoDB (install from https://www.mongodb.com/try/download/community)
# MONGODB_URI=mongodb://localhost:27017
#
# MongoDB Atlas (free tier at https://www.mongodb.com/cloud/atlas)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
#
# Database name (default: finadvisor)
# MONGODB_DB_NAME=finadvisor
#
# Migration: after setting MONGODB_URI run:
#   python server/migrate_to_mongo.py --dry-run
#   python server/migrate_to_mongo.py

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Provider ──────────────────────────────────────────────────────────────
# Set at least one key to enable real LLM responses.
# Priority: Gemini (free tier) → OpenAI → built-in deterministic fallback.
#
# Google Gemini 1.5 Flash (free tier — get key at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your-gemini-api-key
#
# OpenAI GPT-4o-mini (paid — get key at https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your-openai-api-key

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=FinAdvisor AI
APP_VERSION=2.0.0
